ARENA_USER=taha
ARENA_PASSWORD=use-a-separate-long-password
GITHUB_REPOSITORY=tahalkhaftan/RCSS-arena
GITHUB_TOKEN=replace-in-local-env-only-never-commit
STORAGE_REPOSITORY=tahalkhaftan/RCSS-arena-data
GITHUB_REF=main

# Accounts: choose github for the single-instance Render service, or sqlite on a
# persistent disk. Both stores contain private account/payment records.
ARENA_ACCOUNTS_STORE=github
ARENA_ACCOUNT_DB=./data/accounts.sqlite3
ARENA_PUBLIC_URL=https://rcss-arena-public.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional immutable Google user ID, or a verified Gmail address for the owner.
ARENA_OWNER_GOOGLE_SUB=
ARENA_OWNER_EMAIL=
# ARENA_USER / ARENA_PASSWORD also work in the site's owner login form.
# Set only behind a trusted proxy which overwrites X-Forwarded-For:
ARENA_TRUST_PROXY=0

# Activate only after registering your own payment gateway account.
ZARINPAL_MERCHANT_ID=
